# apps/web and apps/widget
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Widget session proxy and bot protection. The same WIDGET_PROXY_SECRET must be
# configured in the widget deployment and the Convex deployment.
WIDGET_PROXY_SECRET=replace-with-at-least-32-random-bytes
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
# Use * for a public multi-customer widget, or a comma-separated allowlist.
WIDGET_ALLOWED_ORIGINS=*

# apps/web: generated customer install snippet
NEXT_PUBLIC_WIDGET_SCRIPT_URL=https://widget.helora.ai/widget.js
NEXT_PUBLIC_WIDGET_URL=https://widget.helora.ai

# Sentry (dashboard)
SENTRY_ORG=replace-me
SENTRY_PROJECT=replace-me
SENTRY_AUTH_TOKEN=replace-me
NEXT_PUBLIC_SENTRY_DSN=https://replace-me.ingest.sentry.io/replace-me

# Convex deployment environment (set with `pnpm --filter @workspace/backend convex env set`)
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
VAPI_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
OPENAI_API_KEY=sk-replace-me
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
RESEND_API_KEY=re_replace-me
TWILIO_ACCOUNT_SID=AC_replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555555555
