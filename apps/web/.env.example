# =============================================================================
# echoAi — apps/web environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in the real values for local dev.
# In production (Vercel), set these in the project's Environment Variables.

# -----------------------------------------------------------------------------
# Public site URL (used for SEO, sitemap, robots, OG image)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://echoai.app

# -----------------------------------------------------------------------------
# Convex (database + serverless functions)
#   - Run `pnpm --filter @workspace/backend setup` to provision a Convex project
#     and it will print the deployment URL.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOYMENT=

# -----------------------------------------------------------------------------
# Clerk (authentication + organizations + billing)
#   - Create an application at https://dashboard.clerk.com
#   - Enable "Organizations" feature
#   - Enable "Billing" feature (Clerk Billing handles subscriptions for you)
#   - Add the Webhook endpoint:  <CONVEX_URL>/clerk-webhook
#     and subscribe to: subscription.updated
# -----------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Webhook secret used by the Convex http handler to verify Clerk webhooks
# (Set this also in your Convex project: `npx convex env set CLERK_WEBHOOK_SECRET ...`)
CLERK_WEBHOOK_SECRET=whsec_xxx

# Where Clerk redirects after sign-in / sign-up (already set in code, optional override)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# -----------------------------------------------------------------------------
# Sentry (error monitoring) — optional but recommended
#   - Create a project at https://sentry.io
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_AUTH_TOKEN=

# -----------------------------------------------------------------------------
# Vapi (voice AI) — set per-organization in the dashboard, not here.
# -----------------------------------------------------------------------------
